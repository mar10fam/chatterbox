# Copy to .env.local and fill in (Supabase → Project Settings → API Keys / Data API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Server-only. Used by scripts (npm run seed). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Python scoring service (speech/server.py). Server-only; the browser goes through /api/score.
SCORER_URL=http://127.0.0.1:8000
